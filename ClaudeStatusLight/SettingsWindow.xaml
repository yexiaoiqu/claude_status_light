<Window x:Class="ClaudeStatusLight.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="配置 - Claude Status Light"
        Width="450" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E1E"
        Foreground="White"
        FontFamily="Microsoft YaHei">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0"
                   Text="工具配置"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,12"/>

        <!-- 扫描区域 -->
        <Border Grid.Row="1"
                Background="#2D2D2D"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="自动检测状态文件"
                           Foreground="White"
                           FontSize="13"
                           Margin="0,0,0,8"/>

                <TextBlock Text="扫描常见 AI 编程工具的状态文件位置"
                           Foreground="#AAAAAA"
                           FontSize="11"
                           Margin="0,0,0,8"/>

                <Button x:Name="ScanButton"
                        Content="🔍 扫描"
                        Background="#0078D4"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="16,6"
                        HorizontalAlignment="Left"
                        FontSize="12"
                        Cursor="Hand"
                        Click="ScanButton_Click"/>

                <TextBlock x:Name="ScanResultText"
                           Text=""
                           Foreground="#80FFFFFF"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- 工具列表 -->
        <Border Grid.Row="2"
                Background="#2D2D2D"
                CornerRadius="8"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 列表标题 -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="85"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="名称" Foreground="#AAAAAA" FontSize="12"/>
                    <TextBlock Grid.Column="1" Text="状态文件路径" Foreground="#AAAAAA" FontSize="12"/>
                    <TextBlock Grid.Column="2" Text="类型" Foreground="#AAAAAA" FontSize="12"/>
                    <TextBlock Grid.Column="3" Text="" Foreground="#AAAAAA" FontSize="12"/>
                </Grid>

                <!-- 工具列表 -->
                <ListBox x:Name="ToolsList"
                         Grid.Row="1"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="85"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#3D3D3D"
                                         Foreground="White"
                                         BorderBrush="#555555"
                                         Padding="4,2"
                                         FontSize="12"/>

                                <TextBox Grid.Column="1"
                                         Text="{Binding StatusFile, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#3D3D3D"
                                         Foreground="White"
                                         BorderBrush="#555555"
                                         Padding="4,2"
                                         Margin="4,0"
                                         FontSize="12"/>

                                <ComboBox Grid.Column="2"
                                          SelectedValue="{Binding ToolType, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Tag"
                                          Background="#3D3D3D"
                                          Foreground="White"
                                          BorderBrush="#555555"
                                          Padding="4,2"
                                          FontSize="12">
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Background" Value="#3D3D3D"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="Padding" Value="4,2"/>
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                    <ComboBoxItem Content="claude" Tag="claude"/>
                                    <ComboBoxItem Content="trae" Tag="trae"/>
                                    <ComboBoxItem Content="其他" Tag="other"/>
                                </ComboBox>

                                <Button Grid.Column="3"
                                        Content="✕"
                                        Background="#DC3232"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Padding="4,2"
                                        FontSize="10"
                                        Cursor="Hand"
                                        Click="DeleteTool_Click"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- 自动检测设置 -->
        <Border Grid.Row="3"
                Background="#2D2D2D"
                CornerRadius="8"
                Padding="12"
                Margin="0,12,0,0">
            <StackPanel>
                <CheckBox x:Name="AutoDetectCheckBox"
                          Content="自动检测活跃工具"
                          Foreground="White"
                          FontSize="13"
                          Margin="0,0,0,8"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="超时时间："
                               Foreground="#AAAAAA"
                               FontSize="12"
                               VerticalAlignment="Center"/>

                    <TextBox Grid.Column="1"
                             x:Name="TimeoutTextBox"
                             Text="60"
                             Background="#3D3D3D"
                             Foreground="White"
                             BorderBrush="#555555"
                             Padding="4,2"
                             Width="50"
                             HorizontalAlignment="Left"
                             FontSize="12"
                             Margin="4,0"/>

                    <TextBlock Grid.Column="2"
                               Text="秒"
                               Foreground="#AAAAAA"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 按钮 -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="取消"
                    Background="#555555"
                    Foreground="White"
                    BorderThickness="0"
                    Padding="20,8"
                    Margin="0,0,8,0"
                    FontSize="13"
                    Cursor="Hand"
                    Click="Cancel_Click"/>

            <Button Content="保存"
                    Background="#0078D4"
                    Foreground="White"
                    BorderThickness="0"
                    Padding="20,8"
                    FontSize="13"
                    Cursor="Hand"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
