<Window x:Class="ClaudeStatusLight.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Status Light"
        Width="80" Height="200"
        WindowStartupLocation="Manual"
        Topmost="True"
        Closing="Window_Closing"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        ShowInTaskbar="False"
        Left="1400" Top="850"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Grid>
        <!-- 半透明背景 -->
        <Border Background="#B0000000"
                CornerRadius="20"
                BorderBrush="#40FFFFFF"
                BorderThickness="1">
            <Border.Effect>
                <BlurEffect Radius="2"/>
            </Border.Effect>
        </Border>

        <!-- 关闭按钮 -->
        <Button x:Name="CloseButton"
                Content="✕"
                Width="18" Height="18"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,4,6,0"
                Background="Transparent"
                Foreground="#80FFFFFF"
                BorderThickness="0"
                FontSize="10"
                Cursor="Hand"
                Click="CloseButton_Click"
                Padding="0"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"/>

        <!-- 内容 -->
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="10,16,10,12">

            <!-- 红灯 -->
            <Ellipse x:Name="RedLight"
                     Width="36" Height="36"
                     HorizontalAlignment="Center"
                     Fill="#DC3232"
                     Margin="0,0,0,6">
                <Ellipse.Effect>
                    <DropShadowEffect x:Name="RedGlow"
                                      BlurRadius="10"
                                      ShadowDepth="0"
                                      Opacity="0"
                                      Color="Red"/>
                </Ellipse.Effect>
            </Ellipse>

            <!-- 黄灯 -->
            <Ellipse x:Name="YellowLight"
                     Width="36" Height="36"
                     HorizontalAlignment="Center"
                     Fill="#F0C828"
                     Margin="0,0,0,6">
                <Ellipse.Effect>
                    <DropShadowEffect x:Name="YellowGlow"
                                      BlurRadius="10"
                                      ShadowDepth="0"
                                      Opacity="0"
                                      Color="Yellow"/>
                </Ellipse.Effect>
            </Ellipse>

            <!-- 绿灯 -->
            <Ellipse x:Name="GreenLight"
                     Width="36" Height="36"
                     HorizontalAlignment="Center"
                     Fill="#32C850"
                     Margin="0,0,0,6">
                <Ellipse.Effect>
                    <DropShadowEffect x:Name="GreenGlow"
                                      BlurRadius="10"
                                      ShadowDepth="0"
                                      Opacity="0"
                                      Color="LimeGreen"/>
                </Ellipse.Effect>
            </Ellipse>

            <!-- 状态文字 -->
            <TextBlock x:Name="StatusText"
                       Text="待机中"
                       Foreground="White"
                       FontSize="11"
                       HorizontalAlignment="Center"
                       FontFamily="Microsoft YaHei"
                       Margin="0,4,0,0"/>
        </StackPanel>
    </Grid>
</Window>
